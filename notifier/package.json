{
  "name": "cinema-notifier",
  "version": "1.0.0",
  "description": "Microservice for Cinema Lab notifications",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "prisma generate && tsc && cp -r src/services/resend/mail-templates dist/services/resend/",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev": "tsx watch src/index.ts",
    "db:deploy": "npx prisma migrate deploy && npx prisma generate",
    "lint": "tsc --noEmit"
  },
  "keywords": [],
  "author": "Yaroslav",
  "license": "ISC",
  "packageManager": "pnpm@10.25.0",
  "dependencies": {
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.1",
    "axios": "^1.13.6",
    "bullmq": "^5.73.4",
    "croner": "^10.0.1",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "pg": "^8.18.0",
    "prom-client": "^15.1.3",
    "resend": "^6.10.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.0",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^3.1.1",
    "prisma": "^7.4.1",
    "supertest": "^7.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.1.1"
  },
  "prisma": {
    "schema": "database/schema.prisma"
  }
}